# Database
DATABASE_URL=postgresql://devmetrics:devmetrics123@localhost:5432/devmetrics
TEST_DATABASE_URL=postgresql://devmetrics:devmetrics123@localhost:5432/devmetrics_test

# Redis
REDIS_URL=redis://localhost:6379/0

# AI APIs (use ONE of these)
# Option 1: OpenRouter (free inference - recommended)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AI_MODEL_PROVIDER=openrouter
# Option 2: OpenAI or OpenAI-compatible
OPENAI_API_KEY=sk-openai-api-key-here
OPENAI_API_BASE=https://openrouter.ai/api/v1
AI_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b:free
# Option 3: Anthropic
ANTHROPIC_API_KEY=sk-ant-api-key-here

# GitHub Integration
GITHUB_APP_ID=
GITHUB_APP_SECRET=
GITHUB_WEBHOOK_SECRET=

# Jira Integration
JIRA_API_TOKEN=
JIRA_WORKSPACE_URL=

# Security
JWT_SECRET_KEY=change-me-to-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENCRYPTION_KEY=change-me-to-random-32-byte-key

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Application
APP_NAME=DevMetrics AI
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
